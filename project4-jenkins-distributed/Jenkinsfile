pipeline {
  agent none
  stages {
    stage('Compile') {
      agent { label 'build' }
      steps {
        echo "DEBUG: Compile stage running on ${env.NODE_NAME}"
        checkout scm
        dir('project4-jenkins-distributed/maven-app') { sh 'mvn -B clean compile' }
        stash name: 'src', includes: 'project4-jenkins-distributed/maven-app/**'
      }
    }
    stage('Test') {
      agent { label 'test' }
      steps {
        echo "DEBUG: Test stage running on ${env.NODE_NAME}"
        unstash 'src'
        dir('project4-jenkins-distributed/maven-app') { sh 'mvn -B test' }
      }
      post { always { echo "DEBUG: Test stage finished on ${env.NODE_NAME}" } }
    }
  }
}
